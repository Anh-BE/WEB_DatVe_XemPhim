@model List<doan3.Models.Mgdb.MgdbPromotionModel>
@{
    ViewBag.Title = "Voucher & Ưu Đãi Khuyến Mãi (MongoDB Mgdb)";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var stats = ViewBag.CategoryStats as List<doan3.Models.Mgdb.MgdbPromotionCategoryStats>;
    var userSession = ViewBag.UserSession as doan3.Models.UserLogin;
    bool isAdmin = ViewBag.IsAdmin == true;
    string currentCategory = ViewBag.CurrentCategory as string ?? "Tất cả";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
}

<style>
    .mgdb-promo-container {
        max-width: 1100px;
        margin: 30px auto;
        color: #fff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .promo-card {
        background-color: #1e1e24;
        border: 1px solid #333;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 25px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .promo-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(243, 156, 18, 0.15);
        border-color: #f39c12;
    }
    .promo-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }
    .badge-code {
        background-color: #f39c12;
        color: #000;
        font-weight: 700;
        font-size: 14px;
        padding: 5px 12px;
        border-radius: 20px;
        letter-spacing: 1px;
    }
    .nav-pills .nav-link {
        color: #bbb;
        background-color: #25252b;
        margin-right: 8px;
        border-radius: 20px;
        padding: 8px 18px;
        font-weight: 500;
    }
    .nav-pills .nav-link.active {
        background-color: #f39c12;
        color: #000;
        font-weight: 700;
    }
    .voucher-box {
        border: 2px dashed #f39c12;
        background-color: rgba(243, 156, 18, 0.08);
        border-radius: 8px;
        padding: 12px;
    }
</style>

<div class="mgdb-promo-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>🎁 Voucher & Ưu Đãi Khuyến Mãi </h2>
        </div>
        @if (Session["APPLIED_VOUCHER_CODE"] != null)
        {
            <div class="badge badge-warning p-2" style="font-size: 14px;">
                <i class="fa fa-ticket-alt mr-1"></i> Đã áp dụng Voucher: <strong>@Session["APPLIED_VOUCHER_CODE"]</strong>
            </div>
        }
    </div>

    @if (userSession == null)
    {
        <!-- BANNER THÔNG BÁO YÊU CẦU ĐĂNG NHẬP DÀNH CHO KHÁCH CHƯA ĐĂNG NHẬP -->
        <div class="card bg-dark text-white border-warning mb-4 p-4 text-center shadow" style="border-radius: 12px; background: linear-gradient(135deg, #1e1e24 0%, #2a2a32 100%); border: 1px solid #f39c12;">
            <div class="card-body">
                <i class="fa fa-gift text-warning mb-2" style="font-size: 45px;"></i>
                <h3 class="text-warning font-weight-bold mb-2">VUI LÒNG ĐĂNG NHẬP TÀI KHOẢN</h3>
                <p class="text-light mb-3" style="font-size: 16px;">Hãy đăng nhập để có thể lấy và sử dụng được những mã Voucher khuyến mãi giảm giá hấp dẫn nhất từ Movana Cinema!</p>
                <a href="@Url.Action("Index_DangNhap", "Login")" class="btn btn-warning btn-lg font-weight-bold px-5 shadow" style="border-radius: 30px; color: #000;">
                    <i class="fa fa-sign-in-alt mr-2"></i> CHUYỂN SANG TRANG ĐĂNG NHẬP NGAY
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- THÔNG BÁO TỪ CONTROLLER -->
        if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                🎉 @TempData["Message"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }
        if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                ⚠️ @TempData["Error"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <!-- LỌC THEO CHUYÊN MỤC KHUYẾN MÃI -->
        <div class="card bg-dark border-secondary mb-4 p-3 rounded shadow-sm">
            <div class="d-flex flex-wrap justify-content-start align-items-center">
                <ul class="nav nav-pills m-0">
                    <li class="nav-item">
                        <a class="nav-link @(currentCategory == "Tất cả" ? "active" : "")" href="@Url.Action("Index", "MgdbPromotion", new { category = "Tất cả" })">Tất cả</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentCategory == "Vé xem phim" ? "active" : "")" href="@Url.Action("Index", "MgdbPromotion", new { category = "Vé xem phim" })">Vé xem phim</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentCategory == "Bắp nước" ? "active" : "")" href="@Url.Action("Index", "MgdbPromotion", new { category = "Bắp nước" })">Bắp nước</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentCategory == "Ví điện tử" ? "active" : "")" href="@Url.Action("Index", "MgdbPromotion", new { category = "Ví điện tử" })">Ví điện tử</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentCategory == "Khuyến mãi Sinh nhật" ? "active" : "")" href="@Url.Action("Index", "MgdbPromotion", new { category = "Khuyến mãi Sinh nhật" })">Sinh nhật</a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- KHU VỰC ADMIN: FORM ĐĂNG KHUYẾN MÃI & THỐNG KÊ AGGREGATION PIPELINE -->
        if (isAdmin)
        {
            <div class="card bg-dark border-warning mb-4 p-4 rounded shadow-sm">
                

                <div class="row">
                    <!-- FORM ĐĂNG KHUYẾN MÃI MỚI (CREATE) -->
                    <div class="col-md-7 border-right border-secondary pr-md-4 mb-3 mb-md-0">
                        <h5 class="text-light mb-3"><i class="fa fa-plus-circle mr-1"></i> Đăng Khuyến mãi / Mã Voucher mới</h5>
                        @using (Html.BeginForm("CreatePromotion", "MgdbPromotion", FormMethod.Post))
                        {
                            <div class="form-row">
                                <div class="form-group col-md-8">
                                    <label class="text-light small">Tên chương trình:</label>
                                    <input type="text" name="title" class="form-control form-control-sm bg-secondary text-white" placeholder="VD: Giảm 50K khi mua 2 vé" required />
                                </div>
                                <div class="form-group col-md-4">
                                    <label class="text-light small">Mã Voucher (Code):</label>
                                    <input type="text" name="code" class="form-control form-control-sm bg-secondary text-white text-uppercase" placeholder="VD: MOVANA50K" required />
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-4">
                                    <label class="text-light small">Danh mục:</label>
                                    <select name="category" class="form-control form-control-sm bg-secondary text-white">
                                        <option value="Vé xem phim">Vé xem phim</option>
                                        <option value="Bắp nước">Bắp nước</option>
                                        <option value="Ví điện tử">Ví điện tử</option>
                                        <option value="Khuyến mãi Sinh nhật">Khuyến mãi Sinh nhật</option>
                                    </select>
                                </div>
                                <div class="form-group col-md-4">
                                    <label class="text-light small">Mức giảm (VNĐ):</label>
                                    <input type="number" name="discountAmount" class="form-control form-control-sm bg-secondary text-white" value="50000" step="5000" required />
                                </div>
                                <div class="form-group col-md-4">
                                    <label class="text-light small">Số lượng phát hành:</label>
                                    <input type="number" name="quantity" class="form-control form-control-sm bg-secondary text-white" value="100" min="1" required />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="text-light small">Nội dung chi tiết & Điều kiện áp dụng:</label>
                                <textarea name="content" rows="2" class="form-control form-control-sm bg-secondary text-white" placeholder="Mô tả điều kiện khuyến mãi..." required></textarea>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-8">
                                    <label class="text-light small">URL Ảnh Banner (nếu có):</label>
                                    <input type="url" name="imageUrl" class="form-control form-control-sm bg-secondary text-white" placeholder="https://images.unsplash.com/..." />
                                </div>
                                <div class="form-group col-md-4">
                                    <label class="text-light small">Thẻ Tags (phân cách dấu phẩy):</label>
                                    <input type="text" name="tagsStr" class="form-control form-control-sm bg-secondary text-white" placeholder="VD: HSSV, Momo, 50K" />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-warning btn-block font-weight-bold"><i class="fa fa-cloud-upload-alt mr-1"></i> Tạo </button>
                        }
                    </div>

                    <!-- BÁO CÁO MONGODB AGGREGATION PIPELINE ($group, $sum) -->
                    <div class="col-md-5 pl-md-4">
                        <h5 class="text-info mb-3"><i class="fa fa-chart-pie mr-1"></i> Thống kê Aggregation Pipeline</h5>
                        @if (stats != null && stats.Count > 0)
                        {
                            <table class="table table-sm table-dark table-bordered text-center small mb-0">
                                <thead class="bg-secondary">
                                    <tr>
                                        <th>Chuyên mục</th>
                                        <th>Số CT</th>
                                        <th>Còn lại</th>
                                        <th>Đã cấp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in stats)
                                    {
                                        <tr>
                                            <td class="text-left font-weight-bold">@item.Category</td>
                                            <td><span class="badge badge-info">@item.TotalPromotions</span></td>
                                            <td><span class="badge badge-success">@item.TotalQuantityLeft</span></td>
                                            <td><span class="badge badge-warning">@item.TotalClaimed</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted small">Chưa có dữ liệu thống kê Aggregation.</p>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- DANH SÁCH BÀI ĐĂNG KHUYẾN MÃI & KHO VOUCHER -->
        <h3 class="mb-4">🔥 Danh Sách Chương Trình Ưu Đãi </h3>

        if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-warning text-center p-4">
                <i class="fa fa-info-circle mr-2" style="font-size: 24px;"></i> Chưa tìm thấy chương trình khuyến mãi nào thuộc danh mục này trong MongoDB.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 d-flex align-items-stretch">
                        <div class="promo-card w-100 d-flex flex-column justify-content-between">
                            <div>
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=600&auto=format&fit=crop" : item.ImageUrl)" class="promo-img" alt="@item.Title" />
                                <div class="p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge badge-secondary">@item.Category</span>
                                        <span class="badge-code">CODE: @item.Code</span>
                                    </div>
                                    <h5 class="text-warning font-weight-bold">@item.Title</h5>
                                    <p class="small text-light">@item.Content</p>

                                    <div class="voucher-box d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <small class="text-muted d-block">Mức giảm giá:</small>
                                            <strong class="text-success style-amount" style="font-size: 18px;">@string.Format("{0:N0}", item.DiscountAmount) VNĐ</strong>
                                        </div>
                                        <div class="text-right">
                                            <small class="text-muted d-block">Số lượng còn lại:</small>
                                            <span class="badge badge-pill badge-primary">@item.Quantity mã</span>
                                            <small class="text-muted ml-1">(Đã lấy: @item.ClaimedCount)</small>
                                        </div>
                                    </div>

                                    @if (item.Tags != null && item.Tags.Count > 0)
                                    {
                                        <div class="mb-2">
                                            @foreach (var tag in item.Tags)
                                            {
                                                <span class="badge badge-outline-warning border border-warning text-warning mr-1">#@tag</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- KHU VỰC THAO TÁC CỦA NGƯỜI DÙNG VÀ ADMIN -->
                            <div class="p-3 pt-0 border-top border-secondary mt-2 d-flex justify-content-between align-items-center">
                                @{
                                    string uname = userSession.UserName;
                                    bool isUsed = item.UsedUsers != null && item.UsedUsers.Contains(uname);
                                    bool isClaimed = item.ClaimedUsers != null && item.ClaimedUsers.Contains(uname);

                                    if (isUsed)
                                    {
                                        <button class="btn btn-sm btn-secondary btn-block font-weight-bold mr-2" disabled>
                                            <i class="fa fa-check-circle mr-1"></i> ĐÃ SỬ DỤNG MÃ NÀY
                                        </button>
                                    }
                                    else if (isClaimed)
                                    {
                                        <button class="btn btn-sm btn-info btn-block font-weight-bold mr-2" disabled>
                                            <i class="fa fa-check-double mr-1"></i> ĐÃ NHẬN MÃ (CODE: @item.Code)
                                        </button>
                                    }
                                    else if (item.Quantity > 0)
                                    {
                                        using (Html.BeginForm("ClaimVoucher", "MgdbPromotion", FormMethod.Post, new { @class = "w-100 mr-2" }))
                                        {
                                            <input type="hidden" name="promoId" value="@item.Id" />
                                            <input type="hidden" name="promoCode" value="@item.Code" />
                                            <button type="submit" class="btn btn-sm btn-warning btn-block font-weight-bold">
                                                <i class="fa fa-hand-holding-heart mr-1"></i> BẤM LẤY MÃ VOUCHER
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-secondary btn-block font-weight-bold mr-2" disabled>
                                            <i class="fa fa-times-circle mr-1"></i> ĐÃ HẾT MÃ
                                        </button>
                                    }

                                    if (isAdmin)
                                    {
                                        using (Html.BeginForm("DeletePromotion", "MgdbPromotion", FormMethod.Post, new { onsubmit = "return confirm('Bạn có chắc chắn muốn xóa bài khuyến mãi này khỏi MongoDB không?');" }))
                                        {
                                            <input type="hidden" name="promoId" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger font-weight-bold" title="Xóa khuyến mãi này">
                                                <i class="fa fa-trash-alt"></i>
                                            </button>
                                        }
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
