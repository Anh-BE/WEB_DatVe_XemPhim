﻿﻿@Html.Partial("_BannerPartial")

@using doan3.Models; 

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Trang chủ";

    // 1. Lấy thông tin User từ Session
    var session = Session["USER_SESSION"] as doan3.Models.UserLogin;

    // 2. Kiểm tra quyền Admin (Giả sử GroupID == 1 là Admin)
    bool isAdmin = (session != null && session.GroupID == "1");
}

@{
    var topBookedNeo4j = ViewBag.TopBookedNeo4j as List<doan3.Models.Neo4jMovieViewModel> ?? new List<doan3.Models.Neo4jMovieViewModel>();
    var topFavsNeo4j = ViewBag.TopFavoritesNeo4j as List<doan3.Models.Neo4jMovieViewModel> ?? new List<doan3.Models.Neo4jMovieViewModel>();
}

<div class="content-wrapper" style="margin-top: 20px;">
    <!-- ========================================================================= -->
    <!-- KHỐI TÍNH NĂNG NEO4J: BẢNG XẾP HẠNG TOP PHIM TRÊN TRANG CHỦ              -->
    <!-- ========================================================================= -->
    <!-- ========================================================================= -->
    <!-- KHỐI TÍNH NĂNG NEO4J: TOP PHIM THỊNH HÀNH (ĐỒNG BỘ NATIVE PHIM-CARD)    -->
    <!-- ========================================================================= -->
    @if (topBookedNeo4j.Count > 0)
    {
        <div class="header-clean" style="margin-top: 10px !important; margin-bottom: 25px !important; text-align: center !important;">
            <h2 class="title-silver" style="font-family: 'Montserrat', sans-serif !important; font-weight: 700 !important; font-size: 26px !important; color: #adc1ff !important; text-transform: uppercase !important; letter-spacing: 2px !important; display: inline-block !important; border-bottom: 3px solid #ffeb00; padding-bottom: 8px !important; margin: 0 !important; text-shadow: 0 0 10px rgba(173, 193, 255, 0.3) !important;">
                🏆 TOP PHIM THỊNH HÀNH
            </h2>
        </div>

        <div class="phim-container" style="margin-bottom: 45px;">
            @{
                int rank = 1;
                foreach (var m in topBookedNeo4j.Take(4))
                {
                    <div class="phim-card" style="position: relative;">
                        <span style="position: absolute; top: 10px; left: 10px; background: rgba(0, 0, 0, 0.85); color: #ffeb00; width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.1rem; border: 2px solid #ffeb00; z-index: 2; box-shadow: 0 4px 10px rgba(0,0,0,0.6);">
                            #@rank
                        </span>
                        <img src="@Url.Content("~/Content/HinhAnhSP/" + m.Poster)" alt="@m.Title" />

                        <div class="phim-info">
                            <p class="phim-title">
                                @(m.Title.Length > 25 ? m.Title.Substring(0, 25) + "..." : m.Title)
                            </p>

                            <div style="margin-bottom: 12px;">
                                <span style="background: rgba(255, 235, 0, 0.15); color: #ffeb00; border: 1px solid rgba(255, 235, 0, 0.4); padding: 4px 12px; border-radius: 15px; font-size: 0.82rem; font-weight: 700;">
                                    <i class="fa fa-ticket"></i> @m.BookingCount Lượt Đặt Vé
                                </span>
                            </div>

                            <div class="phim-buttons">
                                @Html.ActionLink("Chi Tiết", "ChiTietPhim", "Home", new { id = m.MovieId }, new { @class = "btn-movana" })
                                @if (isAdmin)
                                {
                                    @Html.ActionLink("Xem Lịch", "ChonSuat", "DatVe", new { idPhim = m.MovieId }, new { @class = "btn-movana" })
                                }
                                else
                                {
                                    @Html.ActionLink("Đặt Vé", "ChonSuat", "DatVe", new { idPhim = m.MovieId }, new { @class = "btn-movana" })
                                }
                            </div>
                        </div>
                    </div>
                    rank++;
                }
            }
        </div>
    }

    <div class="header-clean" style="margin-top: 40px !important; margin-bottom: 25px !important; text-align: center !important;">
        <h2 class="title-silver" style="font-family: 'Montserrat', sans-serif !important; font-weight: 700 !important; font-size: 26px !important; color: #adc1ff !important; text-transform: uppercase !important; letter-spacing: 2px !important; display: inline-block !important; border-bottom: 3px solid #ffeb00; padding-bottom: 8px !important; margin: 0 !important; text-shadow: 0 0 10px rgba(173, 193, 255, 0.3) !important;">
            PHIM ĐANG CHIẾU
        </h2>
    </div>

    <div class="phim-container">
        @foreach (Phim s in Model)
        {
            <div class="phim-card">
                <img src="@Url.Content("~/Content/HinhAnhSP/" + s.Poster)" alt="@s.TenPhim" />

                <div class="phim-info">
                    <p class="phim-title">
                        @(s.TenPhim.Length > 25 ? s.TenPhim.Substring(0, 25) + "..." : s.TenPhim)
                    </p>

                    <div class="phim-buttons">
                        @Html.ActionLink("Chi Tiết", "ChiTietPhim", "Home", new { id = s.PhimID }, new { @class = "btn-movana" })

                        @* --- LOGIC KIỂM TRA QUYỀN --- *@
                        @if (isAdmin)
                        {
                            // Nếu là ADMIN -> Nút Xem Lịch (Dẫn đến trang quản lý lịch chiếu của phim đó)
                            @Html.ActionLink("Xem Lịch", "ChonSuat", "DatVe", new { idPhim = s.PhimID }, new { @class = "btn-movana" })
                        }
                        else
                        {
                            // Nếu là USER THƯỜNG -> Nút Đặt Vé
                            @Html.ActionLink("Đặt Vé", "ChonSuat", "DatVe", new { idPhim = s.PhimID }, new { @class = "btn-movana" })
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* ... (Giữ nguyên phần CSS cũ của bạn) ... */

    .content-wrapper {
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .phim-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .phim-card {
        background-color: #1a1a2e;
        border-radius: 12px;
        overflow: hidden;
        color: #fff;
        text-align: center;
        transition: 0.3s ease;
        border: 1px solid rgba(255,255,255,0.05);
    }

        .phim-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.5);
            border-color: #ffeb00;
        }

        .phim-card img {
            width: 100%;
            height: 320px;
            object-fit: cover;
        }

    .phim-info {
        padding: 15px;
    }

    .phim-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        margin-bottom: 15px;
        font-size: 1rem;
        height: 2.4rem;
        overflow: hidden;
    }

    .phim-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 10px;
    }

    .btn-movana {
        position: relative;
        display: inline-block;
        padding: 8px 15px;
        font-family: 'Montserrat', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: #000 !important;
        background: #ffeb00;
        border-radius: 8px;
        text-decoration: none !important;
        overflow: hidden;
        z-index: 1;
        transition: color 0.3s ease;
        border: none;
        flex: 1;
        text-transform: uppercase;
    }

        .btn-movana::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, #7f00ff, #3a7bd5);
            transform: translateX(-105%);
            transition: transform 0.4s ease-in-out;
            z-index: -1;
            border-radius: 8px;
        }

        .btn-movana:hover::before {
            transform: translateX(0);
        }

        .btn-movana:hover {
            color: #fff !important;
            box-shadow: 0 4px 12px rgba(127, 0, 255, 0.3);
        }
</style>