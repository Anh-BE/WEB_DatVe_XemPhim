@model List<doan3.Models.Mgdb.MgdbCustomerFeedbackModel>
@{
    ViewBag.Title = "Trung tâm Hỗ trợ & Phản hồi (MongoDB Mgdb)";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var stats = ViewBag.CategoryStats as List<doan3.Models.Mgdb.MgdbFeedbackCategoryStats>;
    var userSession = ViewBag.UserSession as doan3.Models.UserLogin;
    bool isAdmin = ViewBag.IsAdmin == true;
    bool isCustomer = userSession != null && !isAdmin;
}

<style>
    .mgdb-fb-container {
        max-width: 1000px;
        margin: 30px auto;
        color: #fff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .ticket-card {
        background-color: #1e1e24;
        border: 1px solid #333;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }
    .status-badge-New { background-color: #e74c3c; color: white; padding: 3px 8px; border-radius: 4px; }
    .status-badge-InProgress { background-color: #f39c12; color: white; padding: 3px 8px; border-radius: 4px; }
    .status-badge-Resolved { background-color: #2ecc71; color: white; padding: 3px 8px; border-radius: 4px; }
</style>

<div class="mgdb-fb-container">
    <h2>📩 Trung Tâm Hỗ Trợ Và Khiếu Nại</h2>

    @if (userSession == null)
    {
        <!-- CHƯA ĐĂNG NHẬP: CHỈ HIỂN THỊ THÔNG BÁO YÊU CẦU ĐĂNG NHẬP KÈM NÚT CHUYỂN SANG TRANG ĐĂNG NHẬP -->
        <div class="card bg-dark text-white border-warning my-5 p-5 text-center shadow" style="border-radius: 12px; ">
            <div class="card-body">
                <i class="fa fa-lock text-warning mb-3" style="font-size: 60px;"></i>
                <h3 class="text-warning font-weight-bold mb-3">XIN VUI LÒNG ĐĂNG NHẬP TÀI KHOẢN</h3>
                <p class="text-muted mb-4" style="font-size: 16px;">
                    Bạn chưa đăng nhập. Vui lòng đăng nhập tài khoản để gửi yêu cầu hỗ trợ sự cố đặt vé/thanh toán và theo dõi phản hồi từ Ban Quản Trị.
                </p>
                <a href="@Url.Action("Index_DangNhap", "Login")" class="btn btn-lg btn-warning font-weight-bold px-5 py-3 shadow" style="font-size: 18px; border-radius: 30px;">
                    <i class="fa fa-sign-in-alt mr-2"></i> BẤM VÀO ĐÂY ĐỂ ĐĂNG NHẬP NGAY
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- ĐÃ ĐĂNG NHẬP: HIỂN THỊ BANNER NHẬN DIỆN VÀ TOÀN BỘ CHỨC NĂNG KHIẾU NẠI -->
        if (isAdmin)
        {
            <div class="p-3 mb-4 rounded bg-info text-white d-flex justify-content-between align-items-center shadow">
                <div>
                    <strong style="font-size: 17px;"><i class="fa fa-user-shield mr-2"></i> QUYỀN ADMIN / HỆ THỐNG: @userSession.FullName (@userSession.UserName)</strong>
                    
                </div>
                <span class="badge badge-warning p-2" style="font-size: 13px;">ADMINISTRATOR</span>
            </div>

            <!-- HỘP THỐNG KÊ AGGREGATION PIPELINE DÀNH CHO ADMIN -->
            if (stats != null && stats.Count > 0)
            {
                <h4 class="text-info mb-3"><i class="fa fa-chart-pie mr-2"></i> Thống Kê Báo Cáo </h4>
                <div class="row mb-4">
                    @foreach (var item in stats)
                    {
                        <div class="col-md-4">
                            <div class="card bg-dark text-white text-center p-3 mb-2 border-info shadow">
                                <h5 class="text-warning">Chuyên mục: @item.Category</h5>
                                <p class="mb-0">Tổng yêu cầu: <strong>@item.TotalTickets</strong> ticket</p>
                                <small class="text-light">Đã giải quyết: @item.ResolvedCount | Đang xử lý: @item.PendingCount</small>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="p-3 mb-4 rounded bg-success text-white d-flex justify-content-between align-items-center shadow">
                <div>
                    <strong style="font-size: 17px;"><i class="fa fa-user-circle mr-2"></i> XIN CHÀO: @userSession.FullName (@userSession.UserName)</strong>
                    <p class="mb-0 text-white-50" style="font-size: 13px;">Bạn có thể gửi yêu cầu hỗ trợ và theo dõi phản hồi từ Ban Quản Trị.</p>
                </div>
                <span class="badge badge-light p-2 text-dark" style="font-size: 13px;">KHÁCH HÀNG THÀNH VIÊN</span>
            </div>

            <!-- FORM GỬI YÊU CẦU MỚI DÀNH CHO KHÁCH HÀNG -->
            <div class="card bg-dark text-white border-warning mb-4 shadow">
                <div class="card-body">
                    <h4 class="text-warning"><i class="fa fa-paper-plane mr-2"></i> GỬI YÊU CẦU HỖ TRỢ </h4>
                    <p class="text-muted" style="font-size: 13px;">Người gửi: <strong>@userSession.FullName (@userSession.UserName)</strong></p>
                    @using (Html.BeginForm("CreateTicket", "MgdbCustomerFeedback", FormMethod.Post))
                    {
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label>Loại sự cố:</label>
                                <select name="category" class="form-control bg-secondary text-white">
                                    <option value="Thanh toán">Thanh toán vé / Momo / VNPay</option>
                                    <option value="Chất lượng rạp">Chất lượng rạp & Phục vụ</option>
                                    <option value="Khác">Góp ý khác</option>
                                </select>
                            </div>
                            <div class="form-group col-md-8">
                                <label>Tiêu đề yêu cầu:</label>
                                <input type="text" name="subject" class="form-control bg-secondary text-white" placeholder="VD: Bị trừ tiền nhưng chưa thấy vé..." required />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Mô tả chi tiết sự cố:</label>
                            <textarea name="content" class="form-control bg-secondary text-white" rows="3" required></textarea>
                        </div>
                        <div class="form-group">
                            <label>Đường dẫn hình ảnh bằng chứng (nếu có):</label>
                            <input type="url" name="imageUrl" class="form-control bg-secondary text-white" placeholder="https://example.com/evidence.jpg" />
                        </div>
                        <button type="submit" class="btn btn-warning font-weight-bold"><i class="fa fa-paper-plane mr-1"></i> Gửi </button>
                    }
                </div>
            </div>
        }

        if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }
        if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">⚠️ @TempData["Error"]</div>
        }

        <!-- KHU VỰC TÌM KIẾM DÀNH CHO ADMIN -->
        if (isAdmin)
        {
            <div class="card bg-dark border-info mb-4 p-3 rounded shadow-sm">
                <h5 class="text-info mb-2"><i class="fa fa-search mr-2"></i> Tìm Kiếm Người Dùng</h5>
                <p class="text-muted small mb-2">Tên tài khoản (Username), Email, Số điện thoại hoặc Tiêu đề sự cố:</p>
                @using (Html.BeginForm("Index", "MgdbCustomerFeedback", FormMethod.Get, new { @class = "form-inline" }))
                {
                    <div class="input-group w-100">
                        <input type="text" name="search" class="form-control bg-secondary text-white border-0" placeholder="Nhập Username, Email hoặc SĐT người dùng..." value="@ViewBag.CurrentSearch" style="height: 42px;" />
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-info font-weight-bold px-4" style="height: 42px;"><i class="fa fa-search mr-1"></i> TÌM KIẾM</button>
                            @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string))
                            {
                                <a href="@Url.Action("Index", "MgdbCustomerFeedback")" class="btn btn-secondary font-weight-bold px-3 d-flex align-items-center" style="height: 42px;"><i class="fa fa-sync-alt mr-1"></i> XÓA LỌC</a>
                            }
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string))
                {
                    <small class="text-warning mt-2 d-block">🎉 Đã lọc tìm thấy <strong>@Model.Count</strong> khiếu nại phù hợp với từ khóa: "<strong>@ViewBag.CurrentSearch</strong>"</small>
                }
            </div>
        }

        <!-- DANH SÁCH YÊU CẦU HỖ TRỢ -->
        <h3>📋 Lịch sử yêu cầu hỗ trợ</h3>

        if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-info">Chưa có yêu cầu hỗ trợ nào trong MongoDB.</div>
        }
        else
        {
            foreach (var ticket in Model)
            {
                <div class="ticket-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 style="color: #f39c12; margin: 0;">@ticket.Subject</h4>
                        <div class="d-flex align-items-center">
                            <span class="status-badge-@ticket.Status mr-2">@ticket.Status</span>
                            @if (!isAdmin)
                            {
                                using (Html.BeginForm("DeleteTicket", "MgdbCustomerFeedback", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Bạn có chắc chắn muốn xóa khiếu nại này khỏi MongoDB không?');" }))
                                {
                                    <input type="hidden" name="feedbackId" value="@ticket.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger font-weight-bold" title="Hủy / Xóa khiếu nại này">
                                        <i class="fa fa-trash-alt mr-1"></i> Xóa
                                    </button>
                                }
                            }
                        </div>
                    </div>
                    <p class="mt-2 text-light">@ticket.Content</p>
                    <small class="text-muted">Người gửi: <strong>@ticket.Username</strong> | Danh mục: <strong>@ticket.Category</strong> | MongoDB ID: @ticket.Id</small>

                    @if (ticket.Conversations != null && ticket.Conversations.Count > 0)
                    {
                        <div class="mt-3 p-3 bg-dark border-left border-success rounded">
                            <h6 class="text-success"><i class="fa fa-comments mr-1"></i> Phản hồi từ Ban Quản Trị Admin:</h6>
                            @foreach (var conv in ticket.Conversations)
                            {
                                <div class="mb-1 text-light">
                                    <strong>[@conv.Sender]:</strong> @conv.Message
                                </div>
                            }
                        </div>
                    }

                    @if (isAdmin && ticket.Status != "Resolved")
                    {
                        <div class="mt-3">
                            @using (Html.BeginForm("ReplyTicket", "MgdbCustomerFeedback", FormMethod.Post, new { @class = "form-inline" }))
                            {
                                <input type="hidden" name="feedbackId" value="@ticket.Id" />
                                <input type="text" name="replyMessage" class="form-control form-control-sm bg-secondary text-white mr-2" style="width: 350px;" placeholder="Admin nhập câu trả lời giải quyết..." required />
                                <button type="submit" class="btn btn-sm btn-success font-weight-bold"><i class="fa fa-reply mr-1"></i> Trả lời & Đổi sang Resolved</button>
                            }
                        </div>
                    }
                </div>
            }
        }
    }
</div>
